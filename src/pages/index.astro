---
import BaseLayout from '../layouts/BaseLayout.astro';
import Carousel from '../components/Carousel.astro';
import HomeCard from '../components/HomeCard.astro';
import site from '../data/site.json';
import home from '../data/home.json';
---
<BaseLayout title={site.name} description={site.tagline}>
  <div class="mx-auto max-w-6xl px-4 py-6">
    <div class="mb-6 text-center">
      <div class="gcse-searchbox-only"></div>
      <script async src={`https://cse.google.com/cse.js?cx=${site.searchCx}`}></script>
    </div>
    <div class="grid gap-8 md:grid-cols-2">
      <div>
        <Carousel images={home.carousel} />
        <div class="mt-4 flex flex-col gap-1">
          {home.programButtons.map((b) => (
            <a href={b.href} class="list-group-item block text-center rounded bg-navy text-white font-normal py-2 px-3 hover:bg-gold hover:text-navy border border-transparent">{b.label}</a>
          ))}
        </div>
      </div>
      <div>
        <p class="mb-4"><strong>FIELD STATUS:</strong> {home.fieldStatus}</p>
        {home.cards.map((card) => (
          <HomeCard title={card.title} icon={card.icon} body={card.body} />
        ))}
      </div>
    </div>
    {home.quickLinks?.length > 0 && (
      <nav aria-label="Quick links" class="mt-12 border-t border-gray-200 pt-8">
        <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-5">
          {home.quickLinks.map((q) => (
            <li>
              <a href={q.href} class="inline-flex items-center gap-3 text-xl font-bold text-[#2a7ae2] hover:text-navy hover:underline">
                <img src={q.icon} alt="" class="h-12 w-auto" loading="lazy" />
                <span>{q.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</BaseLayout>
