---
import nav from '../data/nav.json';
import site from '../data/site.json';

interface NavEntry { label: string; href: string; children?: NavEntry[] }
const items = nav.items as NavEntry[];
// A sub-item with no link is a group heading (Coaches, Referees, Game Schedules…): the
// dropdown then lays its sub-items out as headed columns, as the old site's menu did.
const hasGroups = (entries: NavEntry[]) => entries.some((e) => !e.href);
const link = 'block px-4 py-2 uppercase text-sm text-gray-800 hover:bg-navy hover:text-white';
const sublink = 'block px-4 py-1 text-sm uppercase text-gray-800 hover:bg-navy hover:text-white';
---
<div id="banner-div" class="hidden md:block bg-[#f3f3f5] text-center">
  <a href="/" class="inline-block">
    <img src="/images/wssl-header-lg.png" alt={site.name} class="mx-auto max-w-[1200px] w-full h-auto" />
  </a>
</div>
<header class="bg-navy text-white">
  <div class="mx-auto max-w-6xl px-4">
    <div class="flex items-center justify-between h-12 lg:hidden">
      <a href="/" class="flex items-center gap-2 md:hidden"><img src="/images/mobile-logo.png" alt={site.shortName} class="h-9 w-auto" /><span class="font-bold text-white">{site.shortName}</span></a>
      <button id="nav-toggle" type="button" class="px-3 py-2 border border-white/40 rounded" aria-expanded="false" aria-controls="site-nav">Menu</button>
    </div>
    <nav id="site-nav" class="hidden lg:block py-2">
      <ul class="flex flex-col lg:flex-row lg:items-center lg:justify-center lg:gap-6">
        <li><a href="/" class="block px-2 py-3 font-bold uppercase tracking-wide hover:text-gold">Home</a></li>
        {items.map((item) => {
          const children = item.children ?? [];
          const grouped = hasGroups(children);
          return (
            <li class="relative group">
              <a href={item.href} class="block px-2 py-3 font-bold uppercase tracking-wide hover:text-gold">{item.label}</a>
              {/* The dropdown panel is white on every screen size: on a phone the menu is a stacked list inside
                  the navy header, so the panel's dark text needs its own light background there too. */}
              {children.length > 0 && (
                <div class={`bg-white mx-2 mb-2 rounded lg:mx-0 lg:mb-0 lg:rounded-none lg:absolute lg:top-full lg:hidden lg:group-hover:block lg:group-focus-within:block lg:shadow-lg lg:z-20 ${grouped ? 'lg:left-1/2 lg:-translate-x-1/2' : 'lg:left-0'}`}>
                  <ul class={`pl-4 lg:pl-0 ${grouped ? 'lg:flex lg:items-stretch' : 'lg:min-w-64'}`}>
                    {children.map((child) => {
                      const sub = child.children ?? [];
                      // In a grouped dropdown every entry with sub-items is a column — a group heading, or a
                      // page that has sub-pages (Training Schedules) — so the columns line up as on the old site.
                      if (grouped && (!child.href || sub.length > 0)) {
                        return (
                          <li class="lg:min-w-56 lg:border-r lg:border-gray-200 lg:last:border-r-0 lg:pb-2">
                            {child.href
                              ? <a href={child.href} class={`block px-4 pt-3 pb-1 font-bold text-navy whitespace-nowrap hover:underline`}>{child.label}</a>
                              : <span class="block px-4 pt-3 pb-1 font-bold text-navy whitespace-nowrap">{child.label}</span>}
                            <ul>
                              {sub.map((g) => (
                                <li><a href={g.href} class={link}>{g.label}</a></li>
                              ))}
                            </ul>
                          </li>
                        );
                      }
                      return (
                        <li>
                          <a href={child.href} class={link}>{child.label}</a>
                          {sub.length > 0 && (
                            <ul class="pl-4">
                              {sub.map((g) => (
                                <li><a href={g.href} class={sublink}>{g.label}</a></li>
                              ))}
                            </ul>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                </div>
              )}
            </li>
          );
        })}
        <li><a href={site.loginUrl} target="_blank" rel="noopener" class="block px-2 py-3 font-bold uppercase tracking-wide hover:text-gold">Login</a></li>
      </ul>
    </nav>
  </div>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const open = !nav.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(open));
    });
  }
</script>
