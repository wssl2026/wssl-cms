---
const suggestions = [
  'How do I register my child?',
  'What is the refund policy?',
  'Where are the fields?',
  'How do I become a referee?',
];
---
<div id="ask-launcher" class="fixed bottom-5 right-5 z-40 flex flex-col items-end gap-2">
  <div id="ask-nudge" class="ask-nudge bg-white text-navy text-sm font-semibold px-4 py-2 rounded-xl shadow-lg border border-gold" role="status" hidden>Have a question about registration, schedules or fields? Ask me!</div>
  <button id="ask-open" type="button" class="ask-open bg-gold text-navy font-bold text-lg px-6 py-4 rounded-full shadow-xl flex items-center gap-3 hover:bg-navy hover:text-gold focus:outline-none focus-visible:ring-4 focus-visible:ring-navy/40 transition-transform hover:scale-105" aria-controls="ask-panel" aria-expanded="false">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true"><path d="M21 12c0 4.4-4 8-9 8-1.2 0-2.4-.2-3.5-.6L3 21l1.6-4.2C3.6 15.4 3 13.8 3 12c0-4.4 4-8 9-8s9 3.6 9 8z"/><path d="M8 12h.01M12 12h.01M16 12h.01"/></svg>
    <span>Ask WSSL</span>
  </button>
</div>

<style>
  /* Soft expanding ring behind the launcher so the button catches the eye without flashing. */
  .ask-open { position: relative; }
  .ask-open::before {
    content: ''; position: absolute; inset: 0; border-radius: 9999px;
    background: #ffbd41; opacity: 0; z-index: -1;
    animation: ask-pulse 2.6s ease-out infinite;
  }
  @keyframes ask-pulse {
    0% { transform: scale(1); opacity: 0.55; }
    70% { transform: scale(1.45); opacity: 0; }
    100% { transform: scale(1.45); opacity: 0; }
  }
  .ask-nudge { animation: ask-nudge-in 0.4s ease-out; position: relative; }
  .ask-nudge::after {
    content: ''; position: absolute; right: 2rem; bottom: -0.45rem; width: 0.9rem; height: 0.9rem;
    background: #fff; border-right: 1px solid #ffbd41; border-bottom: 1px solid #ffbd41; transform: rotate(45deg);
  }
  @keyframes ask-nudge-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  /* Typing indicator inside the assistant bubble while the answer is being prepared. The
     indicator is created by the script below, so it never carries Astro's scoping attribute:
     these rules must be global to reach it. */
  :global(.ask-dots) { display: inline-flex; gap: 0.3rem; align-items: center; }
  :global(.ask-dots i) { width: 0.5rem; height: 0.5rem; border-radius: 9999px; background: #002664; opacity: 0.35; animation: ask-bounce 1.2s ease-in-out infinite; }
  :global(.ask-dots i:nth-child(2)) { animation-delay: 0.15s; }
  :global(.ask-dots i:nth-child(3)) { animation-delay: 0.3s; }
  @keyframes ask-bounce {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.35; }
    40% { transform: translateY(-0.35rem); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ask-open::before, .ask-nudge, :global(.ask-dots i) { animation: none; }
    :global(.ask-dots i) { opacity: 0.7; }
    .ask-open { transition: none; }
  }
</style>

<section id="ask-panel" data-size="compact" class="fixed bottom-5 right-5 z-50 w-[min(24rem,calc(100vw-2.5rem))] h-[min(36rem,calc(100vh-2.5rem))] data-[size=large]:w-[min(56rem,calc(100vw-2.5rem))] data-[size=large]:h-[calc(100vh-2.5rem)] bg-white border border-gray-300 rounded-xl shadow-2xl flex flex-col" hidden aria-label="Ask WSSL assistant">
  <header class="flex items-center justify-between bg-navy text-white px-4 py-3 rounded-t-xl">
    <span class="font-bold">Ask WSSL</span>
    <span class="flex items-center gap-3">
      <button id="ask-expand" type="button" class="text-white/80 hover:text-white text-base leading-none" aria-label="Expand" aria-pressed="false" title="Expand">⤢</button>
      <button id="ask-close" type="button" class="text-white/80 hover:text-white" aria-label="Close">✕</button>
    </span>
  </header>
  <div id="ask-messages" aria-live="polite" class="flex-1 overflow-y-auto p-4 space-y-3 text-sm">
    <div class="text-gray-700">Hi! I answer questions using the pages on wssl.org and link you to them. Answers may not be accurate, so please check the linked source. What would you like to know?</div>
    <div id="ask-suggestions" class="flex flex-wrap gap-2">
      {suggestions.map((s) => <button class="ask-suggest border border-navy text-navy rounded-full px-3 py-1 text-xs hover:bg-navy hover:text-white">{s}</button>)}
    </div>
  </div>
  <form id="ask-form" class="border-t border-gray-200 p-3 flex gap-2">
    <input id="ask-input" aria-label="Your question" class="flex-1 border border-gray-300 rounded px-3 py-2 text-sm" placeholder="Ask about registration, schedules, fields…" maxlength="2000" autocomplete="off" required />
    <button id="ask-send" class="bg-navy text-white font-bold px-4 rounded disabled:opacity-50" type="submit">Send</button>
  </form>
  <p class="text-[11px] text-gray-500 px-3 pb-2">Answers are generated automatically and may not be accurate. Please check the linked source page. Don't share personal or medical details. Questions are logged to help us improve the site.</p>
</section>

<script>
  import { marked } from 'marked';
  import DOMPurify from 'dompurify';
  import { streamChat, type ChatMessage, type ClientEvent } from '../lib/chat-client';

  function $(id: string): HTMLElement {
    return document.getElementById(id) as HTMLElement;
  }
  const panel = $('ask-panel'), openBtn = $('ask-open'), closeBtn = $('ask-close'), expandBtn = $('ask-expand'), launcher = $('ask-launcher'), nudge = $('ask-nudge');
  const list = $('ask-messages'), form = $('ask-form') as HTMLFormElement, input = $('ask-input') as HTMLInputElement, send = $('ask-send') as HTMLButtonElement;

  const STORAGE = 'askwssl:history';
  const SESSION_STORAGE_KEY = 'askwssl:session';
  let inFlight: AbortController | null = null;
  let history: ChatMessage[] = [];
  try { history = JSON.parse(sessionStorage.getItem(STORAGE) ?? '[]'); } catch { history = []; }

  // An anonymous id, random per browser session — no personal data, just lets the question
  // log (Task 19) group a visitor's questions together. Generated once and reused for the
  // life of the tab via sessionStorage; if storage is unavailable it just falls back to an
  // id kept only in memory for this page load.
  function newSessionId(): string {
    return typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function'
      ? crypto.randomUUID()
      : `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
  }
  let sessionId: string;
  try {
    sessionId = sessionStorage.getItem(SESSION_STORAGE_KEY) || '';
    if (!sessionId) {
      sessionId = newSessionId();
      sessionStorage.setItem(SESSION_STORAGE_KEY, sessionId);
    }
  } catch {
    sessionId = newSessionId();
  }

  function render(md: string): string {
    return DOMPurify.sanitize(marked.parse(md, { async: false }) as string, { ADD_ATTR: ['target'] });
  }
  function bubble(role: 'user' | 'assistant'): HTMLDivElement {
    const el = document.createElement('div');
    el.className = role === 'user' ? 'ml-8 bg-navy text-white rounded-lg px-3 py-2' : 'mr-4 bg-gray-100 rounded-lg px-3 py-2 prose prose-sm max-w-none prose-a:text-navy';
    list.appendChild(el);
    return el;
  }
  function sourcesEl(): HTMLDivElement {
    const el = document.createElement('div');
    el.className = 'mr-4 text-xs text-gray-600';
    list.appendChild(el);
    return el;
  }
  function scroll() { list.scrollTop = list.scrollHeight; }

  for (const m of history) { bubble(m.role).innerHTML = m.role === 'user' ? DOMPurify.sanitize(m.content) : render(m.content); }
  if (history.length) $('ask-suggestions')?.remove();

  // "Working" indicator shown in the assistant bubble until the first words stream in:
  // three bouncing dots plus a status line that advances every couple of seconds, so a
  // 5–10 s wait (the assistant reads the page map, then the pages it needs) never looks stuck.
  const WORKING_STEPS = ['Reading the site…', 'Finding the right pages…', 'Writing an answer…'];
  function showWorking(target: HTMLElement): { stop: () => void } {
    target.textContent = '';
    const wrap = document.createElement('div');
    wrap.className = 'ask-working flex items-center gap-3 text-gray-600';
    wrap.setAttribute('aria-live', 'polite');
    const dots = document.createElement('span');
    dots.className = 'ask-dots';
    dots.innerHTML = '<i></i><i></i><i></i>';
    const label = document.createElement('span');
    label.textContent = WORKING_STEPS[0];
    wrap.append(dots, label);
    target.appendChild(wrap);
    let step = 0;
    const timer = window.setInterval(() => {
      step = Math.min(step + 1, WORKING_STEPS.length - 1);
      label.textContent = WORKING_STEPS[step];
    }, 2500);
    let stopped = false;
    return {
      stop() {
        if (stopped) return;
        stopped = true;
        window.clearInterval(timer);
        wrap.remove();
      },
    };
  }

  async function ask(question: string) {
    $('ask-suggestions')?.remove();
    history.push({ role: 'user', content: question });
    bubble('user').textContent = question;
    scroll();
    const out = bubble('assistant');
    const working = showWorking(out);
    scroll();
    send.disabled = true; input.disabled = true;
    let text = '';
    const sources = new Map<string, string>();
    const onEvent = (e: ClientEvent) => {
      if (e.type === 'text') { working.stop(); text += e.text; out.innerHTML = render(text); }
      else if (e.type === 'citation' && e.url) sources.set(e.url, e.title || e.url);
      else if (e.type === 'error') { working.stop(); text = text || e.message; out.innerHTML = render(text); }
      scroll();
    };
    inFlight?.abort();
    const controller = new AbortController();
    inFlight = controller;
    try { await streamChat(history, onEvent, controller.signal, sessionId); }
    finally {
      working.stop();
      if (inFlight === controller) inFlight = null;
      if (sources.size) {
        const s = sourcesEl();
        s.append('Sources: ');
        const entries = [...sources].filter(([url]) => url.startsWith('https://www.wssl.org/'));
        for (let i = 0; i < entries.length; i++) {
          const [url, title] = entries[i];
          const a = document.createElement('a');
          a.href = url;
          a.textContent = title || url;
          a.className = 'underline';
          s.appendChild(a);
          if (i < entries.length - 1) s.append(' · ');
        }
      }
      // An empty assistant turn would be rejected by the API on the next
      // question, so only remember a turn that actually said something.
      if (text.trim()) history.push({ role: 'assistant', content: text });
      history = history.slice(-20);
      try { sessionStorage.setItem(STORAGE, JSON.stringify(history)); } catch { /* storage unavailable */ }
      send.disabled = false; input.disabled = false; input.focus(); scroll();
    }
  }

  const SIZE_KEY = 'askwssl:size';
  function setSize(large: boolean) {
    panel.dataset.size = large ? 'large' : 'compact';
    expandBtn.setAttribute('aria-pressed', String(large));
    expandBtn.setAttribute('aria-label', large ? 'Shrink' : 'Expand');
    expandBtn.title = large ? 'Shrink' : 'Expand';
    expandBtn.textContent = large ? '⤡' : '⤢';
    try { localStorage.setItem(SIZE_KEY, large ? 'large' : 'compact'); } catch { /* storage unavailable */ }
    scroll();
  }
  try { if (localStorage.getItem(SIZE_KEY) === 'large') setSize(true); } catch { /* storage unavailable */ }
  expandBtn.addEventListener('click', () => setSize(panel.dataset.size !== 'large'));
  // One-time nudge per browser session: a small speech bubble above the button after 6 s,
  // gone after 10 s or as soon as the panel opens. The pulse ring on the button itself
  // always runs: it is the site's main call to action and should catch the eye on every page.
  const NUDGE_KEY = 'askwssl:nudged';
  let nudgeTimer: number | undefined;
  const hideNudge = () => { nudge.hidden = true; if (nudgeTimer) window.clearTimeout(nudgeTimer); };
  try {
    if (!sessionStorage.getItem(NUDGE_KEY) && history.length === 0) {
      nudgeTimer = window.setTimeout(() => {
        nudge.hidden = false;
        try { sessionStorage.setItem(NUDGE_KEY, '1'); } catch { /* storage unavailable */ }
        nudgeTimer = window.setTimeout(hideNudge, 10000);
      }, 6000);
    }
  } catch { /* storage unavailable */ }

  // The panel stays open across page loads within the browser session: following a link the
  // assistant gave (or any site link) must not close the conversation. The open/closed state
  // lives in sessionStorage next to the history, so a new tab starts closed.
  const OPEN_KEY = 'askwssl:open';
  function openPanel(focus: boolean) {
    hideNudge();
    panel.hidden = false;
    launcher.hidden = true;
    openBtn.setAttribute('aria-expanded', 'true');
    try { sessionStorage.setItem(OPEN_KEY, '1'); } catch { /* storage unavailable */ }
    if (focus) input.focus();
    scroll();
  }
  function closePanel() {
    inFlight?.abort();
    panel.hidden = true;
    launcher.hidden = false;
    openBtn.setAttribute('aria-expanded', 'false');
    try { sessionStorage.removeItem(OPEN_KEY); } catch { /* storage unavailable */ }
    openBtn.focus();
  }
  openBtn.addEventListener('click', () => openPanel(true));
  closeBtn.addEventListener('click', closePanel);
  // Restore on load without stealing focus from the page the visitor just navigated to.
  try { if (sessionStorage.getItem(OPEN_KEY) === '1') openPanel(false); } catch { /* storage unavailable */ }
  form.addEventListener('submit', (ev) => { ev.preventDefault(); const q = input.value.trim(); if (!q) return; input.value = ''; ask(q); });
  list.addEventListener('click', (ev) => { const b = (ev.target as HTMLElement).closest('.ask-suggest'); if (b) ask(b.textContent!.trim()); });
</script>
