# Ask WSSL runs on Gemini by default (LLM_PROVIDER in wrangler.toml). Set the key for
# whichever provider you select; LLM_PROVIDER and GEMINI_MODEL can be overridden here too.
GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=anthropic
# GEMINI_MODEL=gemini-3.8-flash
DAILY_CAP=1500

# Fine-grained GitHub PAT the editor commits with (Contents: read/write, Metadata: read,
# on the content repo only). In production this is a Cloudflare Pages secret.
GITHUB_BOT_TOKEN=github_pat_...

# Signs the editor's session token (see README "How /admin signs editors in"). Any random
# string of at least 32 characters will do locally; in production it is a Cloudflare Pages
# secret. Without it, or with a shorter one, /api/cms/auth and /api/cms/gh/* both answer 503.
CMS_SESSION_SECRET=

# `wrangler.toml` sets CF_ACCESS_AUD, so blank it here to get the localhost development
# path: with no Access in front of `wrangler pages dev`, /api/cms/auth and /api/cms/gh/*
# accept unauthenticated requests from localhost only, as "local@wssl.org". Remove this
# line to make a valid Access JWT mandatory again.
CF_ACCESS_AUD=

# Task 19: shared secret for the question-log Apps Script (QUESTION_LOG_URL is the plain
# web-app URL, set in wrangler.toml). Leave both unset to keep logging off. See README
# "Question log (Google Sheet)".
QUESTION_LOG_SECRET=
